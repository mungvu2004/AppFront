# Mẫu biến môi trường của AppFront. Chép thành `.env.local` (bị .gitignore) rồi sửa.
# Vite chỉ đưa biến có tiền tố `VITE_` vào mã trình duyệt — KHÔNG đặt bí mật ở đây:
# mọi giá trị `VITE_*` đều nằm công khai trong bản dựng. Khoá DB/S3/SMTP thuộc về
# AppBack (`AppBack/deploy/compose/env.example`).
# Thứ tự Vite nạp: .env → .env.local → .env.[mode] → .env.[mode].local (`pnpm dev:be` dùng mode `be` → `.env.be`).

# --- Dev server (chỉ vite.config.ts đọc, không vào bản dựng) ---
# Đích proxy `/api` khi `pnpm dev`. Mặc định http://localhost:8080 (nginx của stack compose).
VITE_API_PROXY_TARGET=
# Ghi đè header Origin của proxy cho khớp PUBLIC_BASE_URL của BE. Trống = giữ nguyên.
VITE_API_PROXY_ORIGIN=

# --- Mã ứng dụng ---
# URL tuyệt đối của API. Trống = `/api` trên chính origin của trang (cách triển khai chuẩn qua nginx).
VITE_API_BASE_URL=
# `true` = dùng client giả `src/api/__mocks__/` (chỉ dev). Thiếu hoặc khác `true` = server thật.
VITE_USE_MOCK_API=
# `true` = gửi telemetry. Thiếu hoặc khác `true` = tắt.
VITE_TELEMETRY_ENABLED=
# Phiên bản gửi kèm header của client; trống thì lấy giá trị dựng sẵn.
VITE_APP_VERSION=
