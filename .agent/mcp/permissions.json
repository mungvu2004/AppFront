{
  "_comment": "Permission matrix for MCP servers/tools. Read by .agent/mcp/check_permissions.py and enforced conceptually via .claude/settings.json permissions. Categories: auto_allow (read-only, safe), ask_user (mutating or outbound), blocked (never).",
  "default": "ask_user",
  "servers": {
    "filesystem": {
      "auto_allow": ["read_file", "read_text_file", "list_directory", "directory_tree", "search_files", "get_file_info"],
      "ask_user": ["write_file", "edit_file", "create_directory", "move_file"],
      "blocked": ["write_file:.claude/**", "write_file:.agent/policy/**", "write_file:.env", "read_file:.env"]
    },
    "git": {
      "auto_allow": ["git_status", "git_log", "git_diff", "git_show", "git_diff_unstaged", "git_diff_staged"],
      "ask_user": ["git_add", "git_commit", "git_checkout", "git_create_branch"],
      "blocked": ["git_push:--force", "git_reset:--hard"]
    },
    "database": {
      "auto_allow": ["read_query", "list_tables", "describe_table"],
      "ask_user": [],
      "blocked": ["write_query", "create_table", "drop_table", "alter_table"]
    },
    "github": {
      "auto_allow": ["get_file_contents", "list_issues", "get_issue", "list_pull_requests", "get_pull_request", "search_code"],
      "ask_user": ["create_issue", "create_pull_request", "add_issue_comment", "create_or_update_file"],
      "blocked": ["delete_file", "merge_pull_request"]
    },
    "puppeteer": {
      "auto_allow": ["puppeteer_screenshot"],
      "ask_user": ["puppeteer_navigate", "puppeteer_click", "puppeteer_fill", "puppeteer_evaluate"],
      "blocked": []
    },
    "memory": {
      "auto_allow": ["read_graph", "search_nodes", "open_nodes"],
      "ask_user": ["create_entities", "create_relations", "add_observations", "delete_entities"],
      "blocked": []
    },
    "fetch": {
      "auto_allow": [],
      "ask_user": ["fetch"],
      "blocked": [],
      "domain_allowlist": ["code.claude.com", "docs.anthropic.com", "developer.mozilla.org", "react.dev", "vitejs.dev"]
    },
    "internal-api": {
      "auto_allow": ["health_check", "get_sample_dataset"],
      "ask_user": ["trigger_build"],
      "blocked": []
    }
  }
}
