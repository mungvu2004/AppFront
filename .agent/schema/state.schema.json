{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session state (.agent/memory/state.json)",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "status",
    "started_epoch_s",
    "tool_calls",
    "tool_failures",
    "retries",
    "last_event",
    "updated_epoch_s"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "session_id": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "ended"] },
    "source": { "type": "string" },
    "started_epoch_s": { "type": "integer", "minimum": 0 },
    "ended_epoch_s": { "type": "integer", "minimum": 0 },
    "end_reason": { "type": "string" },
    "tool_calls": { "type": "integer", "minimum": 0 },
    "tool_failures": { "type": "integer", "minimum": 0 },
    "retries": { "type": "object" },
    "last_event": {
      "type": "string",
      "enum": [
        "session_start",
        "post_tool_use",
        "post_tool_use_failure",
        "session_end"
      ]
    },
    "updated_epoch_s": { "type": "integer", "minimum": 0 }
  }
}
