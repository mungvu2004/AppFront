{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HARNESS.yaml schema",
  "description": "Validated by the subset validator in .agent/runtime/policy.py (validate_config). Supported keywords: type, required, properties, items, enum, minimum.",
  "type": "object",
  "required": ["version", "guardrail"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "package_manager": { "type": "string" }
      }
    },
    "guardrail": {
      "type": "object",
      "required": [
        "fail_mode",
        "budget_ms",
        "protected_branches",
        "protected_paths",
        "secret_globs",
        "allowed_binaries"
      ],
      "properties": {
        "fail_mode": { "type": "string", "enum": ["closed"] },
        "budget_ms": { "type": "integer", "minimum": 100 },
        "protected_branches": {
          "type": "array",
          "items": { "type": "string" }
        },
        "protected_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secret_globs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed_binaries": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
