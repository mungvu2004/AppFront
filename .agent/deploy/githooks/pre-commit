#!/usr/bin/env bash
# Layer-2 pre-commit gate. Enabled via: git config core.hooksPath .githooks
# This runs even when Claude Code hooks are disabled (--disableAllHooks), so it
# is an independent guardrail. It CANNOT be bypassed with --no-verify from an
# agent session: the guardrail hook + permissions.deny block `git commit
# --no-verify` at the tool layer.
set -euo pipefail
IFS=$'\n\t'

ROOT="$(git rev-parse --show-toplevel)"
PY="python"
command -v python >/dev/null 2>&1 || PY="python3"

# 1. Block committing obvious secrets in staged content.
staged="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -n "$staged" ]; then
  while IFS= read -r file; do
    [ -f "$ROOT/$file" ] || continue
    case "$file" in
      *.env|*.pem|*.key|id_rsa*|id_ed25519*)
        echo "pre-commit: refusing to commit secret-like file: $file" >&2
        exit 1
        ;;
    esac
    if "$PY" "$ROOT/.agent/tools/bin/security-scan.py" "$ROOT/$file" \
        >/dev/null 2>&1; then :; else
      echo "pre-commit: security-scan flagged $file" >&2
      exit 1
    fi
  done <<< "$staged"
fi

# 2. Block committing a hand-tampered compiled policy.
if [ -f "$ROOT/.agent/hooks/config_change.py" ]; then
  if CLAUDE_PROJECT_DIR="$ROOT" "$PY" "$ROOT/.agent/hooks/config_change.py" \
      </dev/null >/dev/null 2>&1; then :; else
    echo "pre-commit: compiled policy integrity check failed" >&2
    exit 1
  fi
fi

echo "pre-commit: OK"
exit 0
