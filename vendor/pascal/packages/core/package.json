{
  "name": "@pascal-app/core",
  "version": "1.0.3",
  "description": "Core library for Pascal 3D building editor",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./clone-scene-graph": {
      "types": "./dist/utils/clone-scene-graph.d.ts",
      "import": "./src/utils/clone-scene-graph.ts",
      "default": "./src/utils/clone-scene-graph.ts"
    },
    "./scene-migrations": {
      "types": "./dist/utils/scene-migrations.d.ts",
      "import": "./src/utils/scene-migrations.ts",
      "default": "./src/utils/scene-migrations.ts"
    },
    "./capture": {
      "types": "./dist/capture/index.d.ts",
      "import": "./src/capture/index.ts",
      "default": "./src/capture/index.ts"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./src/registry/index.ts",
      "default": "./src/registry/index.ts"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./store": {
      "types": "./dist/store/use-scene.d.ts",
      "import": "./src/store/use-scene.ts",
      "default": "./src/store/use-scene.ts"
    },
    "./material-library": {
      "types": "./dist/material-library.d.ts",
      "import": "./src/material-library.ts",
      "default": "./src/material-library.ts"
    },
    "./spatial-grid": {
      "types": "./dist/hooks/spatial-grid/spatial-grid-manager.d.ts",
      "import": "./src/hooks/spatial-grid/spatial-grid-manager.ts",
      "default": "./src/hooks/spatial-grid/spatial-grid-manager.ts"
    },
    "./plan-footprint": {
      "types": "./dist/lib/plan-footprint.d.ts",
      "import": "./src/lib/plan-footprint.ts",
      "default": "./src/lib/plan-footprint.ts"
    },
    "./wall": {
      "types": "./dist/systems/wall/wall-footprint.d.ts",
      "import": "./src/systems/wall/wall-footprint.ts",
      "default": "./src/systems/wall/wall-footprint.ts"
    },
    "./stair-openings": {
      "types": "./dist/systems/stair/stair-opening-sync.d.ts",
      "import": "./src/systems/stair/stair-opening-sync.ts",
      "default": "./src/systems/stair/stair-opening-sync.ts"
    },
    "./procedural-items": {
      "types": "./dist/procedural-items/index.d.ts",
      "import": "./src/procedural-items/index.ts",
      "default": "./src/procedural-items/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build && bun ../../scripts/fix-node-esm-imports.ts dist",
    "dev": "tsgo --build --watch",
    "test": "bun test src",
    "check-types": "tsc -p tsconfig.contracts.json --pretty false",
    "bench:registry": "bun run src/registry/__bench__/relations-resolver.bench.ts",
    "bench:schema": "bun run src/schema/__bench__/node-parsers.bench.ts",
    "smoke:node": "node --input-type=module -e \"await import('./dist/index.js')\"",
    "prepublishOnly": "npm run build && npm run smoke:node"
  },
  "peerDependencies": {
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "react": "^18 || ^19",
    "three": "^0.186"
  },
  "dependencies": {
    "dedent": "^1.7.1",
    "idb-keyval": "^6.2.2",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.6",
    "zod": ">=4.5.4 <4.6",
    "zundo": "^2.3.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@pascal/typescript-config": "workspace:*",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.2",
    "@types/three": "^0.184.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "6.0.3"
  },
  "keywords": [
    "3d",
    "building",
    "editor",
    "architecture",
    "webgpu",
    "three.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pascalorg/editor.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "homepage": "https://github.com/pascalorg/editor/tree/main/packages/core#readme",
  "bugs": "https://github.com/pascalorg/editor/issues"
}
