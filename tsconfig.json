{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "next/image": [
        "./vendor/pascal/shims/next-image.tsx"
      ],
      "@iconify/react": [
        "./vendor/pascal/packages/editor/node_modules/@iconify/react"
      ],
      "@radix-ui/react-tooltip": [
        "./vendor/pascal/packages/editor/node_modules/@radix-ui/react-tooltip"
      ],
      "next/link": [
        "./vendor/pascal/shims/next-link.tsx"
      ]
    },
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "e2e/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tailwind.config.ts",
    ".storybook/**/*.ts"
  ],
  "exclude": [
    "src/components/pascal",
    "src/pascal-page"
  ]
}